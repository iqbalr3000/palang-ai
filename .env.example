# Palang AI — the one environment file for the gateway, dashboard and database migrations.
# `bun run setup` copies this to .env and fills in the secrets for you.
# Every app reads .env from the repo root; values already set in your environment take precedence.

# ── Required ─────────────────────────────────────────────────────────────────────────────────

# Postgres 16 (gateway, migrations). Matches the container in the README.
DATABASE_URL=postgres://palang:palang@localhost:5432/palang

# Admin API token (gateway) — the dashboard uses it too. `bun run setup` generates one;
# otherwise: openssl rand -hex 32
PALANG_ADMIN_TOKEN=

# Dashboard sign-in password. `bun run setup` generates one; change it to anything you like.
DASHBOARD_PASSWORD=

# The model provider requests are forwarded to (referenced by palang.yaml as ${UPSTREAM_...}).
# The bundled mock server — no API key needed, start it with `bun run mock`:
UPSTREAM_BASE_URL=http://localhost:9090/v1
UPSTREAM_API_KEY=unused
# Or any OpenAI-compatible provider:
# UPSTREAM_BASE_URL=https://api.openai.com/v1
# UPSTREAM_API_KEY=sk-...

# ── Optional ─────────────────────────────────────────────────────────────────────────────────

# Gateway config file (default ./palang.yaml)
# PALANG_CONFIG=./palang.yaml

# Gateway log level: fatal | error | warn | info | debug | trace | silent (default info)
# LOG_LEVEL=info

# Where the dashboard finds the gateway's admin API (default http://localhost:8081)
# PALANG_ADMIN_URL=http://localhost:8081
