{
  "name": "palang-ai",
  "private": true,
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "gateway",
    "dashboard",
    "guards",
    "mock-upstream",
    "evals"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "bun run --filter '*' lint",
    "eval": "bun run --filter @palang-ai/evals eval",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "setup": "bun run scripts/setup.ts",
    "db:migrate": "bun run --filter @palang-ai/gateway migrate",
    "mock": "bun run mock-upstream/src/index.ts",
    "gateway": "bun run gateway/src/index.ts",
    "dashboard": "bun run --filter @palang-ai/dashboard build && bun run --filter @palang-ai/dashboard start"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "prettier": "^3.4.0",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.19.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,mjs,json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
