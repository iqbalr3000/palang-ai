{
  "name": "palang-ai",
  "private": true,
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*",
    "evals"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "eval": "bun run --filter @palang-ai/evals eval",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "setup": "bun run scripts/setup.ts",
    "db:migrate": "bun run --filter @palang-ai/db migrate",
    "mock": "bun run apps/mock-upstream/src/index.ts",
    "gateway": "bun run apps/gateway/src/index.ts",
    "dashboard": "bun run --filter @palang-ai/dashboard build && bun run --filter @palang-ai/dashboard start"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "prettier": "^3.4.0",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.19.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,mjs,json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
